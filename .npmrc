# expo-router's optional web-platform tabs UI pulls in vaul -> @radix-ui/* ->
# react-dom, whose peer requirement drifts ahead of the app's pinned `react`
# version. None of that code ever runs in an iOS build (this app has no web
# target in use), but `npm ci` — which EAS Build always runs, unlike a local
# `npm install` — treats the unmet peer as fatal instead of a warning.
# legacy-peer-deps makes npm ci match npm install's lenient behavior instead of
# hard-failing on it. Safe here: nothing actually depends on react-dom resolving
# at a specific version for the artifacts this project ships (iOS/Android).
legacy-peer-deps=true
