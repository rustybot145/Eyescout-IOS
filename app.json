{
  "expo": {
    "name": "EyeScout Sports",
    "slug": "eyescout-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "eyescout",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#111111",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.eyescoutsports.mobile",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.eyescoutsports.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#111111",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "com.android.vending.BILLING"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-secure-store",
      "expo-splash-screen",
      [
        "expo-image-picker",
        {
          "photosPermission": "EyeScout uses your photo library so you can set a profile photo and share your highlights.",
          "cameraPermission": "EyeScout uses your camera so you can capture photos and highlights to share."
        }
      ]
    ],
    "extra": {
      "revenueCatIosKey": "",
      "revenueCatAndroidKey": ""
    }
  }
}
